# EnergiBox backend configuration
#
# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and must NEVER be committed.

# ── Database (required) ────────────────────────────────────────────────
# Use a dedicated MySQL account scoped to the energibox database, not root.
ENERGIBOX_DB_USER=energibox
ENERGIBOX_DB_PASSWORD=change-me
ENERGIBOX_DB_HOST=localhost
ENERGIBOX_DB_PORT=3306
ENERGIBOX_DB_NAME=energibox
# How many authenticated connections to keep warm. 0 turns pooling off and
# reopens one per query, which is what the backend did before DBUtils.
ENERGIBOX_DB_POOL_SIZE=8

# ── JWT signing (required) ─────────────────────────────────────────────
# Generate a fresh one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing this value invalidates every token already issued.
ENERGIBOX_SECRET_KEY=change-me
ENERGIBOX_JWT_ALGORITHM=HS256
ENERGIBOX_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── MQTT broker ────────────────────────────────────────────────────────
ENERGIBOX_MQTT_BROKER=localhost
ENERGIBOX_MQTT_PORT=1883
# Leave both empty while Mosquitto still allows anonymous connections.
ENERGIBOX_MQTT_USERNAME=
ENERGIBOX_MQTT_PASSWORD=

# ── HTTP ───────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
ENERGIBOX_CORS_ORIGINS=http://localhost:5173

# ── Optional: artificial intelligence (llm.py) ────────────────────────
# Writes the advisor's tips and the monthly report, in English and French.
# Tried in this order; leave all empty and the app uses its templates.
#
# Groq, free tier: https://console.groq.com/keys (no card). Prompts are
# not used for training.
# ENERGIBOX_GROQ_API_KEY=
# ENERGIBOX_GROQ_MODEL=openai/gpt-oss-120b
#
# Google AI Studio (Gemini), free tier, used when Groq is out of quota:
# https://aistudio.google.com/apikey. On the free tier Google may use
# prompts to improve its models (outside the EU/UK); only aggregated
# energy figures and appliance names are sent.
# ENERGIBOX_GEMINI_API_KEY=
# ENERGIBOX_GEMINI_MODEL=gemini-2.5-flash
#
# Any OpenAI-compatible endpoint, tried last — e.g. Ollama on this server,
# free and fully private (`ollama pull llama3.1:8b`).
# ENERGIBOX_LLM_URL=http://localhost:11434/v1/chat/completions
# ENERGIBOX_LLM_MODEL=llama3.1:8b
# ENERGIBOX_LLM_API_KEY=
