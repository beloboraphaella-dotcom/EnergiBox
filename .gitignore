# ── Secrets — never commit these ───────────────────────────────────────
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Local Claude Code state: settings.local.json holds machine-specific
# permission rules and has previously leaked credentials and JWTs.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── Node ───────────────────────────────────────────────────────────────
node_modules/
dist/
.vite/

# ── Editors / OS ───────────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/

# ── Logs ───────────────────────────────────────────────────────────────
*.log
